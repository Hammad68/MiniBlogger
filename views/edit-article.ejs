<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MiniBlogger | Edit Blog</title>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="/main.css" />

  <!-- Quill CSS -->
  <link href="/quill/quill.snow.css" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #0d1117;
      background-image:
        radial-gradient(ellipse at 20% 55%, rgba(99,179,237,.07) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 15%, rgba(154,117,234,.05) 0%, transparent 55%);
      min-height: 100vh;
      margin: 0;
      color: #f0f6fc;
    }

    /* ─── Header ─── */
    .site-header {
      background: rgba(13,17,23,.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,.07);
      padding: 0 2rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .site-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.45rem;
      color: #fff;
      letter-spacing: -.02em;
      margin: 0;
    }
    .site-logo span { color: #63b3ed; }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      background: transparent;
      border: 1px solid rgba(255,255,255,.1);
      color: #8b949e;
      font-family: 'Inter', sans-serif;
      font-size: .8rem;
      font-weight: 500;
      padding: .38rem .85rem;
      border-radius: 8px;
      text-decoration: none;
      transition: border-color .2s, color .2s, background .2s;
    }
    .btn-back:hover {
      border-color: rgba(99,179,237,.5);
      color: #63b3ed;
      background: rgba(99,179,237,.07);
      text-decoration: none;
    }

    /* ─── Layout ─── */
    .edit-layout {
      max-width: 820px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    /* ─── Page heading ─── */
    .page-heading {
      text-align: center;
      margin-bottom: 1.75rem;
      animation: slideUp .4s ease both;
    }
    .page-heading h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      color: #f0f6fc;
      margin-bottom: .35rem;
    }
    .page-heading p {
      font-size: .82rem;
      color: #8b949e;
      font-weight: 300;
      margin: 0;
    }

    /* ─── Meta badges ─── */
    .meta-row {
      display: flex;
      justify-content: center;
      gap: .75rem;
      flex-wrap: wrap;
      margin-bottom: 1.75rem;
      animation: slideUp .4s ease .05s both;
    }
    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 8px;
      padding: .35rem .8rem;
      font-size: .78rem;
      color: #8b949e;
    }
    .meta-badge i { font-size: .7rem; color: #63b3ed; }
    .meta-badge .val { color: #f0f6fc; font-weight: 500; }

    /* ─── Status colour ─── */
    .status-draft     { color: #d97706; }
    .status-published { color: #86efac; }

    /* ─── Form card ─── */
    .edit-card {
      background: #161b22;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      padding: 2.25rem 2.5rem;
      box-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 28px 64px rgba(0,0,0,.55);
      animation: slideUp .5s cubic-bezier(.22,1,.36,1) .1s both;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── Form fields ─── */
    .form-group-custom { margin-bottom: 1.5rem; }

    .form-label-custom {
      display: block;
      font-size: .73rem;
      font-weight: 600;
      color: #8b949e;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: .45rem;
    }

    .input-custom {
      width: 100%;
      background: #0d1117;
      border: 1.5px solid rgba(255,255,255,.1);
      border-radius: 8px;
      color: #f0f6fc;
      font-family: 'Inter', sans-serif;
      font-size: .88rem;
      padding: .65rem .9rem;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
      -webkit-appearance: none;
    }
    .input-custom::placeholder { color: #484f58; }
    .input-custom:focus {
      border-color: #63b3ed;
      box-shadow: 0 0 0 3px rgba(99,179,237,.15);
    }

    /* ─── Quill editor ─── */
    .editor-wrapper {
      border: 1.5px solid rgba(255,255,255,.1);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color .2s, box-shadow .2s;
    }
    .editor-wrapper:focus-within {
      border-color: #63b3ed;
      box-shadow: 0 0 0 3px rgba(99,179,237,.15);
    }

    .editor-wrapper .ql-toolbar.ql-snow {
      background: #0d1117;
      border: none;
      border-bottom: 1px solid rgba(255,255,255,.08);
      padding: .6rem .75rem;
    }
    .editor-wrapper .ql-toolbar .ql-stroke { stroke: #8b949e; }
    .editor-wrapper .ql-toolbar .ql-fill   { fill:   #8b949e; }
    .editor-wrapper .ql-toolbar .ql-picker-label { color: #8b949e; }
    .editor-wrapper .ql-toolbar button:hover .ql-stroke,
    .editor-wrapper .ql-toolbar .ql-picker-label:hover .ql-stroke { stroke: #63b3ed; }
    .editor-wrapper .ql-toolbar button:hover .ql-fill { fill: #63b3ed; }

    .editor-wrapper .ql-container.ql-snow {
      background: #0d1117;
      border: none;
      min-height: 300px;
      font-family: 'Inter', sans-serif;
      font-size: .9rem;
    }
    .editor-wrapper .ql-editor { color: #f0f6fc; min-height: 300px; padding: 1rem; }
    .editor-wrapper .ql-editor.ql-blank::before { color: #484f58; font-style: normal; }
    .editor-wrapper .ql-editor a { color: #63b3ed; }

    /* ─── Field hints ─── */
    .field-hint {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: .45rem;
      font-size: .75rem;
      color: #484f58;
    }

    #charCount { font-weight: 600; color: #8b949e; transition: color .2s; }
    #charCount.ok   { color: #86efac; }
    #charCount.warn { color: #fbbf24; }
    #charCount.bad  { color: #ffa198; }

    .form-divider {
      border: none;
      border-top: 1px solid rgba(255,255,255,.07);
      margin: 1.75rem 0;
    }

    /* ─── Submit button ─── */
    .btn-submit {
      width: 100%;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: .88rem;
      font-weight: 600;
      padding: .75rem 1rem;
      cursor: pointer;
      letter-spacing: .02em;
      transition: opacity .2s, transform .15s;
      background: linear-gradient(135deg, #1d6fa4, #2563eb);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
    }
    .btn-submit:hover:not(:disabled)  { opacity: .9; transform: translateY(-1px); }
    .btn-submit:active:not(:disabled) { transform: translateY(0); }
    .btn-submit:disabled {
      opacity: .35;
      cursor: not-allowed;
      transform: none;
    }
  </style>
</head>

<body>

  <!-- Header -->
  <header class="site-header">
    <div class="site-logo">Mini<span>Blogger</span></div>
    <a href="/blog/author-homepage" class="btn-back">
      <i class="fa fa-arrow-left"></i> Back
    </a>
  </header>

  <!-- Main -->
  <div class="edit-layout">

    <!-- Heading -->
    <div class="page-heading">
      <h2>Edit Blog</h2>
      <p>Make changes to your draft below and save when ready.</p>
    </div>

    <!-- Meta info badges -->
    <div class="meta-row">
      <span class="meta-badge">
        <i class="fa fa-calendar"></i> Created: <span class="val"><%= blog.createdAgo %></span>
      </span>
      <span class="meta-badge">
        <i class="fa fa-pencil"></i> Modified: <span class="val"><%= blog.modifiedAgo %></span>
      </span>
      <span class="meta-badge">
        <i class="fa fa-tag"></i> Status:
        <span class="val <%= blog.blog_status === 'published' ? 'status-published' : 'status-draft' %>">
          <%= blog.blog_status %>
        </span>
      </span>
    </div>

    <!-- Form card -->
    <div class="edit-card">
      <form id="edit-blog" action="/blog/update-blog/<%= blog.blog_id %>" method="post">

        <!-- Title -->
        <div class="form-group-custom">
          <label for="title" class="form-label-custom">Title</label>
          <input type="text" class="input-custom" id="title" name="title"
                 maxlength="100" value="<%= blog.blog_title %>" required>
          <div class="field-hint"><span>Max 100 characters</span></div>
        </div>

        <!-- Content -->
        <div class="form-group-custom">
          <label class="form-label-custom">Content</label>
          <div class="editor-wrapper">
            <div id="editor"></div>
          </div>
          <textarea id="content" name="content" style="display:none;"></textarea>
          <div class="field-hint">
            <span>Minimum 200 characters required</span>
            <span>Characters: <span id="charCount">0</span> / 5000</span>
          </div>
        </div>

        <hr class="form-divider">

        <!-- Submit -->
        <button type="submit" class="btn-submit" id="save-btn">
          <i class="fa fa-floppy-o"></i> Save Changes
        </button>

      </form>
    </div>

  </div>

  <!-- Bootstrap JS -->
  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>

  <!-- Quill JS -->
  <script src="/quill/quill.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const existingContent = <%- JSON.stringify(blog.blog_content || '') %>;

      // Init Quill
      const quill = new Quill('#editor', {
        theme: 'snow',
        placeholder: 'Start writing your blog content here...',
        modules: {
          toolbar: [
            [{ 'header': [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
            ['link'],
            ['clean']
          ]
        }
      });

      // Load existing content
      if (existingContent && existingContent.length > 0) {
        quill.root.innerHTML = existingContent;
      }

      const charCount   = document.getElementById('charCount');
      const saveBtn     = document.getElementById('save-btn');
      const titleField  = document.getElementById('title');
      const form        = document.getElementById('edit-blog');

      const originalContent = quill.root.innerHTML;
      const originalTitle   = titleField.value;

      // Character counter with colour states
      function updateCharCount() {
        const len = quill.getText().trim().length;
        charCount.textContent = len;
        charCount.className = len < 200 ? 'bad' : len > 4500 ? 'warn' : 'ok';
      }

      // Save button enable/disable
      function checkChanges() {
        const changed = quill.root.innerHTML !== originalContent || titleField.value !== originalTitle;
        saveBtn.disabled = !changed;
      }

      updateCharCount();
      saveBtn.disabled = true;

      quill.on('text-change', function () {
        updateCharCount();
        checkChanges();
      });

      titleField.addEventListener('input', checkChanges);

      // Form submission validation
      form.addEventListener('submit', function (e) {
        const text       = quill.getText().trim();
        const titleLen   = titleField.value.trim().length;

        if (titleLen < 5) {
          e.preventDefault();
          alert('Title must be at least 5 characters.');
          return;
        }
        if (text.length < 200) {
          e.preventDefault();
          alert('Content must be at least 200 characters. Current: ' + text.length);
          return;
        }
        if (text.length > 5000) {
          e.preventDefault();
          alert('Content must be under 5000 characters. Current: ' + text.length);
          return;
        }

        document.getElementById('content').value = quill.root.innerHTML;
      });
    });
  </script>

</body>
</html>
