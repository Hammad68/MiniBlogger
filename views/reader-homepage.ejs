<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MiniBlogger | Reader</title>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #0d1117;
      background-image:
        radial-gradient(ellipse at 20% 55%, rgba(99,179,237,.07) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 15%, rgba(154,117,234,.05) 0%, transparent 55%);
      min-height: 100vh;
      color: #f0f6fc;
    }

    /* Header */
    .site-header {
      background: rgba(13,17,23,.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,.07);
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .site-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.45rem;
      color: #fff;
      letter-spacing: -.02em;
      margin: 0;
    }
    .site-logo span { color: #63b3ed; }

    .btn-logout {
      background: transparent;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      color: #8b949e;
      font-family: 'Inter', sans-serif;
      font-size: .82rem;
      font-weight: 500;
      padding: .45rem 1rem;
      cursor: pointer;
      transition: color .2s, border-color .2s;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
    }
    .btn-logout:hover { color: #f0f6fc; border-color: rgba(255,255,255,.3); }

    /* Page layout */
    .page {
      max-width: 1060px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 5rem;
    }

    /* Welcome card */
    .welcome-card {
      background: #161b22;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      padding: 2.5rem 2.25rem;
      box-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 28px 64px rgba(0,0,0,.55);
      display: flex;
      align-items: center;
      gap: 2rem;
      margin-bottom: 2rem;
      animation: slideUp .5s cubic-bezier(.22,1,.36,1) both;
    }

    .welcome-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 58px; height: 58px;
      background: linear-gradient(135deg, #1e3a5f, #2d4a7a);
      border-radius: 14px;
      flex-shrink: 0;
      box-shadow: 0 4px 18px rgba(99,179,237,.2);
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      color: #63b3ed;
    }

    .welcome-text h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.55rem;
      color: #f0f6fc;
      margin-bottom: .3rem;
    }

    .welcome-text p {
      font-size: .84rem;
      color: #8b949e;
      font-weight: 300;
      margin: 0;
      line-height: 1.6;
    }

    /* Section card */
    .section-card {
      background: #161b22;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 18px;
      box-shadow: 0 0 0 1px rgba(255,255,255,.03), 0 28px 64px rgba(0,0,0,.55);
      margin-bottom: 2rem;
      overflow: hidden;
      animation: slideUp .5s .08s cubic-bezier(.22,1,.36,1) both;
    }

    .section-header {
      padding: 1.2rem 2rem;
      border-bottom: 1px solid rgba(255,255,255,.07);
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .section-header i { color: #63b3ed; font-size: .9rem; }

    .section-header h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      color: #f0f6fc;
      margin: 0;
      font-weight: 700;
    }

    .section-body { padding: 1.5rem 2rem; }

    /* Search */
    .search-row {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
    }

    .input-custom {
      flex: 1;
      min-width: 200px;
      background: #0d1117;
      border: 1.5px solid rgba(255,255,255,.1);
      border-radius: 8px;
      color: #f0f6fc;
      font-family: 'Inter', sans-serif;
      font-size: .88rem;
      padding: .65rem .9rem;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .input-custom::placeholder { color: #484f58; }
    .input-custom:focus {
      border-color: #63b3ed;
      box-shadow: 0 0 0 3px rgba(99,179,237,.15);
    }

    .btn-submit {
      border: none;
      border-radius: 8px;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: .88rem;
      font-weight: 600;
      padding: .65rem 1.4rem;
      cursor: pointer;
      letter-spacing: .02em;
      transition: opacity .2s, transform .15s;
      background: linear-gradient(135deg, #1d6fa4, #2563eb);
      white-space: nowrap;
    }
    .btn-submit:hover  { opacity: .9; transform: translateY(-1px); }
    .btn-submit:active { transform: translateY(0); }

    /* Error box */
    .error-box {
      margin-top: 1rem;
      background: rgba(248,81,73,.1);
      border: 1px solid rgba(248,81,73,.3);
      border-radius: 8px;
      color: #ffa198;
      font-size: .84rem;
      padding: .65rem .9rem;
    }

    /* Results table */
    .results-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .88rem;
    }

    .results-table thead th {
      padding: .85rem 1.5rem;
      background: rgba(255,255,255,.03);
      color: #8b949e;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      text-align: left;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .results-table tbody tr {
      border-bottom: 1px solid rgba(255,255,255,.05);
      transition: background .15s;
    }
    .results-table tbody tr:last-child { border-bottom: none; }
    .results-table tbody tr:hover { background: rgba(255,255,255,.03); }

    .results-table tbody td {
      padding: .9rem 1.5rem;
      color: #f0f6fc;
      font-weight: 300;
    }

    .no-results {
      padding: 1.5rem 0;
      text-align: center;
      color: #8b949e;
      font-size: .9rem;
      font-weight: 300;
    }

    /* Blog grid */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
      padding: 1.5rem 2rem;
    }

    .blog-card {
      background: #0d1117;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: .85rem;
      transition: border-color .25s, transform .25s, box-shadow .25s;
      position: relative;
      overflow: hidden;
    }

    .blog-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, #1d6fa4, #63b3ed);
      opacity: 0;
      transition: opacity .3s;
    }

    .blog-card:hover {
      border-color: rgba(99,179,237,.25);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,.4);
    }
    .blog-card:hover::before { opacity: 1; }

    .blog-card .card-index {
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #63b3ed;
    }

    .blog-card h4 {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      color: #f0f6fc;
      line-height: 1.45;
      flex: 1;
    }

    .blog-card .meta {
      font-size: .76rem;
      color: #8b949e;
      font-weight: 300;
    }

    .blog-card .read-link {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-size: .82rem;
      font-weight: 500;
      color: #63b3ed;
      text-decoration: none;
      letter-spacing: .02em;
      transition: gap .2s, color .2s;
      margin-top: auto;
    }
    .blog-card .read-link:hover { gap: .6rem; color: #90cdf4; }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 580px) {
      .welcome-card { flex-direction: column; gap: 1rem; }
      .page { padding: 1.5rem 1rem 4rem; }
      .site-header { padding: .9rem 1.2rem; }
      .section-body, .blog-grid { padding: 1.2rem; }
      .results-table thead th,
      .results-table tbody td { padding: .75rem 1rem; }
    }
  </style>
</head>

<body>

  <!-- Header -->
  <header class="site-header">
    <div class="site-logo">Mini<span>Blogger</span></div>
    <form method="POST" action="/blog/logout">
      <button type="submit" class="btn-logout">
        <i class="fa fa-sign-out"></i> Logout
      </button>
    </form>
  </header>

  <div class="page">

    <!-- Welcome -->
    <% names.forEach(name => { %>
    <div class="welcome-card">
      <div class="welcome-icon"><%= name ? name.name[0].toUpperCase() : '?' %></div>
      <div class="welcome-text">
        <h2>Welcome back, <%= name.name %></h2>
        <p><%= name.about || 'Explore insights, stories, and ideas shared here.' %></p>
      </div>
    </div>
    <% }); %>

    <!-- Search -->
    <div class="section-card">
      <div class="section-header">
        <i class="fa fa-search"></i>
        <h3>Search Posts</h3>
      </div>
      <div class="section-body">
        <form action="/blog/search-blog" method="GET">
          <div class="search-row">
            <input
              class="input-custom"
              type="text"
              name="searchBox"
              placeholder="Search by name…"
              id="search-box"
            >
            <button type="submit" class="btn-submit">
              Search &nbsp;<i class="fa fa-arrow-right"></i>
            </button>
          </div>
        </form>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="error-box">
            <% errors.forEach(err => { %><p><%= err.msg %></p><% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Search Results — only shown after a search is performed -->
    <% if (typeof searchResults !== 'undefined') { %>
    <div class="section-card">
      <div class="section-header">
        <i class="fa fa-table"></i>
        <h3>Search Results</h3>
      </div>
      <% if (searchResults.length > 0) { %>
        <table class="results-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Date of Birth</th>
              <th>Email</th>
              <th>Phone</th>
            </tr>
          </thead>
          <tbody>
            <% searchResults.forEach(function(patient) { %>
              <tr>
                <td><%= patient.blog_id %></td>
                <td><%= patient.blog_title %></td>
                <td><%= patient.blog_content %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="no-results">No results found for that search.</p>
      <% } %>
    </div>
    <% } %>

    <!-- Blog grid -->
    <div class="section-card">
      <div class="section-header">
        <i class="fa fa-book"></i>
        <h3>Recent Publications</h3>
      </div>
      <div class="blog-grid">
        <% blogs.forEach((blog, i) => { %>
          <div class="blog-card">
            <span class="card-index">Post #<%= String(i + 1).padStart(2, '0') %></span>
            <h4><%= blog.blog_title %></h4>
            <p class="meta"><i class="fa fa-calendar-o" style="margin-right:.35rem;"></i><%= blog.formattedDate %></p>
            <a href="/blog/reader-blog/<%= blog.blog_id %>" class="read-link">
              Read article <i class="fa fa-arrow-right"></i>
            </a>
          </div>
        <% }); %>
      </div>
    </div>

  </div>

  <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
</body>
</html>
