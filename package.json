{
  "name": "miniblogger",
  "version": "1.0.0",
  "description": "Blogging app with Express, EJS, and SQLite3",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-db": "cat ./db/db_schema.sql | sqlite3 ./db/blog.db",
    "clean-db": "rm ./db/blog.db",
    "build-db-win": "sqlite3 ./db/blog.db < ./db/db_schema.sql",
    "clean-db-win": "del .\\db\\blog.db"
  },
